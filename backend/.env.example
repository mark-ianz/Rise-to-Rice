# Server
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Validation
MINIMUM_USERNAME_LENGTH=4
MAXIMUM_USERNAME_LENGTH=30
MINIMUM_PASSWORD_LENGTH=8
CONTACT_NUMBER_LENGTH=11

# Database
DB_HOSTNAME=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-me
DB_NAME=rise-to-rice

# Authentication
SALT_ROUND=10
ACCESS_TOKEN_SECRET=replace-me
REFRESH_TOKEN_SECRET=replace-me
ACCESS_TOKEN_JWT_EXPIRES_IN=15m
REFRESH_TOKEN_JWT_EXPIRES_IN=7d
ACCESS_TOKEN_COOKIE_MAX_AGE=900000
REFRESH_TOKEN_COOKIE_MAX_AGE=604800000
REFRESH_TOKEN_SQL_INTERVAL="7 DAY"
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
PASSWORD_RESET_PROOF_TTL_MINUTES=10
VERIFICATION_CODE_RESEND_INTERVAL_SECONDS=120


# Email (SMTP / Resend)
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME='Rise to Rice'

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
CLOUDINARY_FOLDER=rise-to-rice
